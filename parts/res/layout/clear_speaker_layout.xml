<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="@string/clear_speaker_summary"
            android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
            android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_speaker_action"
            style="@style/SettingsLibButtonStyle.Expressive.Tonal.Large"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="40dp"
            android:minHeight="72dp"
            android:text="@string/clear_speaker_start"
            app:icon="@drawable/ic_play"
            app:iconSize="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settingslib_round_background"
            android:paddingHorizontal="32dp"
            android:paddingVertical="22dp"
            android:text="@string/clear_speaker_description"
            android:textAppearance="@style/TextAppearance.SettingsLib.BodyLarge"
            android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
